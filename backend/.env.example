PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=workflow_automation_db

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_department_workflow_2026
JWT_EXPIRES_IN=24h

# Groq AI Configuration (Ultra-Fast LPU Inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@institution.edu
SMTP_PASS=app_specific_password
EMAIL_FROM=Workflow Automation Agent <no-reply@institution.edu>

# Client Application URL
CLIENT_URL=http://localhost:3000

# File Upload Settings
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads
